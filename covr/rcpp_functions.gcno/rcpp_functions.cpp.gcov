      108:   38:        std::set<int> active;
        -:   39:
        -:   40:        // Lmf stores the total contributions that reach each metafounder
      108:   41:        NumericVector Lmf(nmf, 0.0);
        -:   42:
        -:   43:        // Start from individual i itself
