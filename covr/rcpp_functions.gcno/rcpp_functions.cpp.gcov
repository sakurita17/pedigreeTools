        -:   48:
      558:   49:        while (!active.empty()) {
        -:   50:
      450:   51:            int j = *active.rbegin();
      450:   52:            active.erase(j);
        -:   53:
      450:   54:            double Lj = Lrow[j];
      450:   55:            if (Lj == 0.0) continue;
      450:   56:            Lrow[j] = 0.0;
        -:   57:
        -:   58:            // Case 1: j is a metafounder
      450:   59:            if (j < nmf) {
