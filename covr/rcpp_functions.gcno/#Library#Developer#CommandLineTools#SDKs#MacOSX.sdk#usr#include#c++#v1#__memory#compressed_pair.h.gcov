        -:   24:_LIBCPP_BEGIN_NAMESPACE_STD
        -:   25:
        -:   26:// ================================================================================================================== //
        -:   27:// The utilites here are for staying ABI compatible with the legacy `__compressed_pair`. They should not be used      //
        -:   28:// for new data structures. Use `_LIBCPP_NO_UNIQUE_ADDRESS` for new data structures instead (but make sure you        //
        -:   29:// understand how it works).                                                                                          //
        -:   30:// ================================================================================================================== //
        -:   31:
        -:   32:// The first member is aligned to the alignment of the second member to force padding in front of the compressed pair
        -:   33:// in case there are members before it.
        -:   34://
        -:   35:// For example:
        -:   36:// (assuming x86-64 linux)
        -:   37:// class SomeClass {
        -:   38://   uint32_t member1;
        -:   39://   _LIBCPP_COMPRESSED_PAIR(uint32_t, member2, uint64_t, member3);
        -:   40:// }
        -:   41://
        -:   42:// The layout with __compressed_pair is:
        -:   43:// member1 - offset: 0,  size: 4
        -:   44:// padding - offset: 4,  size: 4
        -:   45:// member2 - offset: 8,  size: 4
        -:   46:// padding - offset: 12, size: 4
        -:   47:// member3 - offset: 16, size: 8
        -:   48://
        -:   49:// If the [[gnu::aligned]] wasn't there, the layout would instead be:
        -:   50:// member1 - offset: 0, size: 4
        -:   51:// member2 - offset: 4, size: 4
        -:   52:// member3 - offset: 8, size: 8
        -:   53://
        -:   54:// Furthermore, that alignment must be the same as what was used in the old __compressed_pair layout, so we must
        -:   55:// handle reference types specially since alignof(T&) == alignof(T).
        -:   56:// See https://github.com/llvm/llvm-project/issues/118559.
        -:   57:
        -:   58:#ifndef _LIBCPP_ABI_NO_COMPRESSED_PAIR_PADDING
        -:   59:
        -:   60:template <class _Tp>
        -:   61:inline const size_t __compressed_pair_alignment = _LIBCPP_ALIGNOF(_Tp);
        -:   62:
        -:   63:template <class _Tp>
        -:   64:inline const size_t __compressed_pair_alignment<_Tp&> = _LIBCPP_ALIGNOF(void*);
        -:   65:
        -:   66:template <class _ToPad,
        -:   67:          bool _Empty = ((is_empty<_ToPad>::value && !__libcpp_is_final<_ToPad>::value) ||
        -:   68:                         is_reference<_ToPad>::value || sizeof(_ToPad) == __datasizeof_v<_ToPad>)>
      450:   69:class __compressed_pair_padding {
      450:   70:  char __padding_[sizeof(_ToPad) - __datasizeof_v<_ToPad>] = {};
        -:   71:};
        -:   72:
        -:   73:template <class _ToPad>
        -:   74:class __compressed_pair_padding<_ToPad, true> {};
        -:   75:
        -:   76:// TODO: Fix the ABI for GCC as well once https://gcc.gnu.org/bugzilla/show_bug.cgi?id=121637 is fixed
        -:   77:#  ifdef _LIBCPP_COMPILER_GCC
        -:   78:#    define _LIBCPP_COMPRESSED_PAIR(T1, Initializer1, T2, Initializer2)                                                \
        -:   79:      _LIBCPP_NO_UNIQUE_ADDRESS __attribute__((__aligned__(::std::__compressed_pair_alignment<T2>))) T1 Initializer1;  \
        -:   80:      _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T1> _LIBCPP_CONCAT3(__padding1_, __LINE__, _);        \
        -:   81:      _LIBCPP_NO_UNIQUE_ADDRESS T2 Initializer2;                                                                       \
        -:   82:      _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T2> _LIBCPP_CONCAT3(__padding2_, __LINE__, _)
        -:   83:
        -:   84:#    define _LIBCPP_COMPRESSED_TRIPLE(T1, Initializer1, T2, Initializer2, T3, Initializer3)                            \
        -:   85:      _LIBCPP_NO_UNIQUE_ADDRESS                                                                                        \
        -:   86:      __attribute__((__aligned__(::std::__compressed_pair_alignment<T2>),                                              \
        -:   87:                     __aligned__(::std::__compressed_pair_alignment<T3>))) T1 Initializer1;                            \
        -:   88:      _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T1> _LIBCPP_CONCAT3(__padding1_, __LINE__, _);        \
        -:   89:      _LIBCPP_NO_UNIQUE_ADDRESS T2 Initializer2;                                                                       \
        -:   90:      _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T2> _LIBCPP_CONCAT3(__padding2_, __LINE__, _);        \
        -:   91:      _LIBCPP_NO_UNIQUE_ADDRESS T3 Initializer3;                                                                       \
        -:   92:      _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T3> _LIBCPP_CONCAT3(__padding3_, __LINE__, _)
        -:   93:#  else
        -:   94:#    define _LIBCPP_COMPRESSED_PAIR(T1, Initializer1, T2, Initializer2)                                                \
        -:   95:      struct {                                                                                                         \
        -:   96:        _LIBCPP_NO_UNIQUE_ADDRESS                                                                                      \
        -:   97:        __attribute__((__aligned__(::std::__compressed_pair_alignment<T2>))) T1 Initializer1;                          \
        -:   98:        _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T1> _LIBCPP_CONCAT3(__padding1_, __LINE__, _);      \
        -:   99:        _LIBCPP_NO_UNIQUE_ADDRESS T2 Initializer2;                                                                     \
        -:  100:        _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T2> _LIBCPP_CONCAT3(__padding2_, __LINE__, _);      \
        -:  101:      }
        -:  102:
        -:  103:#    define _LIBCPP_COMPRESSED_TRIPLE(T1, Initializer1, T2, Initializer2, T3, Initializer3)                            \
        -:  104:      struct {                                                                                                         \
        -:  105:        _LIBCPP_NO_UNIQUE_ADDRESS                                                                                      \
        -:  106:        __attribute__((__aligned__(::std::__compressed_pair_alignment<T2>),                                            \
        -:  107:                       __aligned__(::std::__compressed_pair_alignment<T3>))) T1 Initializer1;                          \
        -:  108:        _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T1> _LIBCPP_CONCAT3(__padding1_, __LINE__, _);      \
        -:  109:        _LIBCPP_NO_UNIQUE_ADDRESS T2 Initializer2;                                                                     \
        -:  110:        _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T2> _LIBCPP_CONCAT3(__padding2_, __LINE__, _);      \
        -:  111:        _LIBCPP_NO_UNIQUE_ADDRESS T3 Initializer3;                                                                     \
        -:  112:        _LIBCPP_NO_UNIQUE_ADDRESS ::std::__compressed_pair_padding<T3> _LIBCPP_CONCAT3(__padding3_, __LINE__, _);      \
        -:  113:      }
        -:  114:#  endif
        -:  115:
